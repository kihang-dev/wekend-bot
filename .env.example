BOT_TOKEN="여기에_봇_인증_토큰"
# 관리용 REST API 키 (비워두면 API 꺼짐). 아무 긴 문자열이나 OK
API_KEY="여기에_긴_임의_문자열"
# API 포트 (기본 8000)
# API_PORT=8000
# 개발 맥에서만: 폴더 변경을 GitHub에 자동 커밋·푸시
AUTO_PUSH=1
# GitHub 새 버전 확인 주기(초). 맥 30, 클라우드 서버는 300 권장 (트래픽 절약)
# UPDATE_CHECK_SEC=300
# 매월 회비 안내에 쓸 입금 계좌 (비우면 회비 안내를 보내지 않음)
# DUES_ACCOUNT="은행 계좌번호"
# 관리자 botUserKey 추가 (쉼표 구분, 선택). 기본 관리자는 첫 실행 때 admins.json 에 자동 기록
# ADMIN_KEYS="키1,키2"
